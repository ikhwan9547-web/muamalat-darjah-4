    function loadSavedGame() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          gameState = {
            ...gameState,
            ...parsed,
            soundSettings: { ...gameState.soundSettings, ...(parsed.soundSettings || {}) }
          };
        }
      } catch (e) {
        console.debug("Failed to read localStorage", e);
      }
      applySoundSettings();
      updateHeaderUI();
      updateLevelsUI();
    }

    function saveGame() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(gameState));
      } catch (e) {
        console.debug("Failed to save to localStorage", e);
      }
      updateHeaderUI();
      updateLevelsUI();
    }

    function executeResetGame() {
      gameState = {
        unlockedLevels: [1],
        completedLevels: [],
        coins: 0,
        badges: [],
        soundSettings: {
          bgm: true,
          sfx: true,
          volume: 0.7
        }
      };
      saveGame();
      closeModal('modal-confirm-reset');
      closeModal('modal-settings');
      showScreen('screen-home');
      soundManager.playWrong();
    }

    function requestResetGame() {
      soundManager.playClick();
      openModal('modal-confirm-reset');
    }

    function showScreen(screenId) {
      soundManager.playClick();
      const screens = ['screen-home', 'screen-levels', 'screen-game', 'screen-result', 'screen-victory', 'screen-bonus'];
      screens.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.add('hidden');
      });
      const target = document.getElementById(screenId);
      if (target) {
        target.classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      if (screenId === 'screen-levels' || screenId === 'screen-home') {
        updateLevelsUI();
      }
    }

    function startGame() {
      soundManager.init();
      soundManager.playClick();
      if (gameState.soundSettings.bgm) {
        soundManager.startBgm();
      }
      showScreen('screen-levels');
    }

    function updateHeaderUI() {
      const elCoins = document.getElementById('header-coins');
      const elBadges = document.getElementById('header-badges');
      if (elCoins) elCoins.innerText = gameState.coins;
      if (elBadges) elBadges.innerText = `${gameState.badges.length}/5`;
    }

    function updateLevelsUI() {
      const completedCount = gameState.completedLevels.length;
      const progressPercent = Math.round((completedCount / 5) * 100);

      const elText = document.getElementById('levels-progress-text');
      const elBar = document.getElementById('levels-progress-bar');
      if (elText) elText.innerText = `${completedCount} / 5 Tahap (${progressPercent}%)`;
      if (elBar) elBar.style.width = `${progressPercent}%`;

      for (let lvl = 1; lvl <= 5; lvl++) {
        const isUnlocked = gameState.unlockedLevels.includes(lvl);
        const isCompleted = gameState.completedLevels.includes(lvl);

        const cardEl = document.getElementById(`card-stage-${lvl}`);
        const statusEl = document.getElementById(`status-stage-${lvl}`);
        const btnEl = document.getElementById(`btn-stage-${lvl}`);

        if (lvl === 1) {
          if (isCompleted) {
            statusEl.innerHTML = `<span class="text-emerald-700 font-bold">✓ Selesai (10/10)</span>`;
          } else {
            statusEl.innerHTML = `<span class="text-emerald-600 font-bold">● Terbuka</span>`;
          }
          continue;
        }

        if (isCompleted) {
          if (cardEl) cardEl.className = "bg-white rounded-2xl p-5 border-2 border-emerald-500 shadow-md flex flex-col justify-between";
          if (statusEl) statusEl.innerHTML = `<span class="text-emerald-700 font-bold">✓ Selesai (10/10)</span>`;
          if (btnEl) {
            btnEl.className = "btn-3d px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl shadow cursor-pointer";
            btnEl.innerText = "Ulang Kaji ➔";
            btnEl.disabled = false;
          }
        } else if (isUnlocked) {
          if (cardEl) cardEl.className = "bg-white rounded-2xl p-5 border-2 border-amber-400 shadow-lg flex flex-col justify-between";
          if (statusEl) statusEl.innerHTML = `<span class="text-amber-600 font-bold">⚡ Sedia untuk Kuiz</span>`;
          if (btnEl) {
            btnEl.className = "btn-3d px-4 py-2 bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold text-xs rounded-xl shadow cursor-pointer";
            btnEl.innerText = "Mula Kuiz ➔";
            btnEl.disabled = false;
          }
        } else {
          if (cardEl) cardEl.className = "bg-slate-50 rounded-2xl p-5 border-2 border-slate-200 shadow-sm flex flex-col justify-between opacity-80";
          if (statusEl) statusEl.innerHTML = `<span class="text-slate-500 font-medium">🔒 Perlu Lulus Tahap ${lvl - 1}</span>`;
          if (btnEl) {
            btnEl.className = "btn-3d px-4 py-2 bg-slate-300 text-slate-500 font-bold text-xs rounded-xl cursor-not-allowed";
            btnEl.innerText = "Kunci 🔒";
            btnEl.disabled = true;
          }
        }
      }
    }

    /* ==========================================================================
       5. SISTEM KUIZ & SOALAN DENGAN SYARAT 10/10
       ========================================================================== */
    let currentLevel = 1;
    let currentQIndex = 0;
    let currentLevelScore = 0;
    let currentLevelQuestions = [];
    let isQuestionAnswered = false;

    /* ==========================================================================
       5B. SISTEM MOD JAWAPAN TEKANAN ISYARAT JARI (PADA SKRIN — TANPA KAMERA)
       ========================================================================== */
    let currentAnswerMode = 'touch'; // 'touch' atau 'gesture'
    let pendingLevelToStart = null;

    function openChooseModeModal(lvl = null) {
      soundManager.playClick();
      if (lvl) pendingLevelToStart = lvl;
      openModal('modal-choose-mode');
    }

    function confirmChooseMode(mode) {
      soundManager.playClick();
      closeModal('modal-choose-mode');

      if (mode === 'gesture') {
        openModal('modal-gesture-guide');
      } else {
        setAnswerMode(mode);
        if (pendingLevelToStart) {
          const l = pendingLevelToStart;
          pendingLevelToStart = null;
          enterLevel(l);
        }
      }
    }

    function confirmStartFromGuide() {
      closeModal('modal-gesture-guide');
      setAnswerMode('gesture');
      if (pendingLevelToStart) {
        const l = pendingLevelToStart;
        pendingLevelToStart = null;
        enterLevel(l);
      } else {
        const scrGame = document.getElementById('screen-game');
        if (scrGame && scrGame.classList.contains('hidden')) {
          showScreen('screen-levels');
        }
      }
    }

    function setAnswerMode(mode) {
      soundManager.playClick();
      currentAnswerMode = mode;

      const btnTouch = document.getElementById('btn-mode-touch');
      const btnGesture = document.getElementById('btn-mode-gesture');
      const hudContainer = document.getElementById('gesture-hud-container');

      if (mode === 'gesture') {
        if (btnGesture) btnGesture.className = "px-3 py-1 rounded-lg text-xs font-bold bg-amber-500 text-slate-900 shadow-sm transition flex items-center space-x-1";
        if (btnTouch) btnTouch.className = "px-3 py-1 rounded-lg text-xs font-bold text-slate-600 hover:text-emerald-700 transition flex items-center space-x-1";
        if (hudContainer) hudContainer.classList.remove('hidden');

        // Mulakan kamera latar belakang (tanpa paparan video)
        initBackgroundGestureTracking();
      } else {
        if (btnTouch) btnTouch.className = "px-3 py-1 rounded-lg text-xs font-bold bg-emerald-600 text-white shadow-sm transition flex items-center space-x-1";
        if (btnGesture) btnGesture.className = "px-3 py-1 rounded-lg text-xs font-bold text-slate-600 hover:text-emerald-700 transition flex items-center space-x-1";
        if (hudContainer) hudContainer.classList.add('hidden');

        // Hentikan kamera dan pemprosesan serta-merta
        stopBackgroundGestureTracking();
      }

      updateOptionLabelsStyle();
    }

    function updateOptionLabelsStyle() {
      const qData = currentLevelQuestions[currentQIndex];
      if (!qData) return;

      const gestureSymbols = ['☝️ [A] 1 Jari', '✌️ [B] 2 Jari', '🤟 [C] 3 Jari', '🖖 [D] 4 Jari'];
      const standardLabels = ['A', 'B', 'C', 'D'];

      qData.options.forEach((_, idx) => {
        const badge = document.getElementById(`opt-label-${idx}`);
        if (badge) {
          if (currentAnswerMode === 'gesture') {
            badge.innerText = gestureSymbols[idx];
            badge.className = "px-2.5 py-1 rounded-xl bg-amber-100 text-amber-900 font-black text-xs flex-shrink-0 border-2 border-amber-300 shadow-sm";
          } else {
            badge.innerText = standardLabels[idx];
            badge.className = "w-7 h-7 rounded-xl bg-slate-100 text-slate-700 font-bold flex items-center justify-center text-xs flex-shrink-0 border border-slate-300";
          }
        }
      });
    }

    /* ==========================================================================
       5C. ENJIN PENGECAMAN ISYARAT JARI SEBENAR (LATAR BELAKANG — TANPA VIDEO)
       ========================================================================== */
    let gestureCameraInstance = null;
    let mediapipeHandsInstance = null;
    let gestureStream = null;
    let isGestureTrackingActive = false;

    // Pembolehubah pemantauan kestabilan 1 saat
    let candidateChoice = null;
    let candidateStartTime = 0;
    const GESTURE_HOLD_DURATION_MS = 1000; // 1 saat stabil

    async function initBackgroundGestureTracking() {
      const errBox = document.getElementById('gesture-error-alert');
      const errMsg = document.getElementById('gesture-error-msg');
      if (errBox) errBox.classList.add('hidden');

      const videoElement = document.getElementById('gesture-hidden-video');
      if (!videoElement) return;

      // Semak sokongan getUserMedia
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        showGestureError("Pelayar web ini tidak menyokong akses kamera. Sila gunakan Mod Tekan Jawapan.");
        return;
      }

      // Semak ketersediaan MediaPipe Hands
      if (typeof Hands === 'undefined') {
        showGestureError("Pustaka pengesanan tangan sedang dimuatkan atau terhalang. Sila semak sambungan internet atau guna Mod Tekan.");
        return;
      }

      try {
        updateGestureHUDStatus("Memulakan kamera latar belakang...", "🟡", false);

        if (!mediapipeHandsInstance) {
          mediapipeHandsInstance = new Hands({
            locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`
          });

          mediapipeHandsInstance.setOptions({
            maxNumHands: 1,
            modelComplexity: 1,
            minDetectionConfidence: 0.6,
            minTrackingConfidence: 0.5
          });

          mediapipeHandsInstance.onResults(onGestureLandmarksDetected);
        }

        // Minta kebenaran kamera pengguna
        gestureStream = await navigator.mediaDevices.getUserMedia({
          video: {
            facingMode: 'user',
            width: { ideal: 640 },
            height: { ideal: 480 }
          },
          audio: false
        });

        videoElement.srcObject = gestureStream;
        await videoElement.play();

        isGestureTrackingActive = true;
        updateGestureHUDStatus("Kamera Aktif di Latar Belakang (Tanpa Paparan Video)", "🟢", true);

        // Gelung pemprosesan bingkai kamera latar belakang
        processGestureFrameLoop();

      } catch (err) {
        console.warn("Ralat akses kamera:", err);
        let msg = "Kebenaran kamera ditolak atau kamera tidak tersedia. Sila gunakan Mod Tekan Jawapan.";
        if (err.name === 'NotAllowedError' || err.name === 'PermissionDeniedError') {
          msg = "Akses kamera tidak dibenarkan oleh pengguna. Sila gunakan Mod Tekan Jawapan.";
        } else if (err.name === 'NotFoundError') {
          msg = "Tiada perkakasan kamera dikesan pada peranti ini. Beralih ke Mod Tekan Jawapan.";
        }
        showGestureError(msg);
      }
    }

    async function processGestureFrameLoop() {
      const videoElement = document.getElementById('gesture-hidden-video');
      if (!isGestureTrackingActive || !videoElement || videoElement.paused || videoElement.ended) {
        return;
      }

      try {
        if (mediapipeHandsInstance && videoElement.readyState >= 2) {
          await mediapipeHandsInstance.send({ image: videoElement });
        }
      } catch (e) {
        console.debug("Gesture frame send tick", e);
      }

      if (isGestureTrackingActive) {
        requestAnimationFrame(processGestureFrameLoop);
      }
    }

    function stopBackgroundGestureTracking() {
      isGestureTrackingActive = false;
      candidateChoice = null;
      candidateStartTime = 0;
      resetGestureProgressBar();

      const videoElement = document.getElementById('gesture-hidden-video');
      if (videoElement) {
        videoElement.pause();
        videoElement.srcObject = null;
      }

      if (gestureStream) {
        gestureStream.getTracks().forEach(track => track.stop());
        gestureStream = null;
      }

      updateGestureHUDStatus("Kamera Tidak Aktif", "⚪", false);
    }

    function showGestureError(msg) {
      stopBackgroundGestureTracking();
      const errBox = document.getElementById('gesture-error-alert');
      const errMsg = document.getElementById('gesture-error-msg');
      if (errBox && errMsg) {
        errMsg.innerText = `⚠️ ${msg}`;
        errBox.classList.remove('hidden');
      }
      updateGestureHUDStatus("Kamera Terhenti / Ralat", "🔴", false);
    }

    function updateGestureHUDStatus(text, dotColor, isPinging) {
      const stText = document.getElementById('gesture-status-text');
      const stDot = document.getElementById('gesture-status-dot');
      const stPing = document.getElementById('gesture-status-ping');

      if (stText) stText.innerText = text;
      if (stDot) {
        stDot.className = dotColor === "🟢"
          ? "relative inline-flex rounded-full h-3 w-3 bg-emerald-500"
          : (dotColor === "🟡" ? "relative inline-flex rounded-full h-3 w-3 bg-amber-500" : "relative inline-flex rounded-full h-3 w-3 bg-rose-500");
      }
      if (stPing) {
        stPing.style.display = isPinging ? 'inline-flex' : 'none';
      }
    }

    function onGestureLandmarksDetected(results) {
      if (!isGestureTrackingActive || isQuestionAnswered) {
        resetGestureProgressBar();
        return;
      }

      if (!results.multiHandLandmarks || results.multiHandLandmarks.length === 0) {
        // Tangan tidak kelihatan di hadapan kamera
        updateGestureLiveHUD(null, "Tangan tidak dikesan. Sila angkat tangan di hadapan kamera.", "✋");
        resetCandidate();
        return;
      }

      const landmarks = results.multiHandLandmarks[0];
      const fingerCount = countExtendedFingers(landmarks);

      // Pemetaan:
      // 1 Jari = Pilihan 0 (A)
      // 2 Jari = Pilihan 1 (B)
      // 3 Jari = Pilihan 2 (C)
      // 4 Jari = Pilihan 3 (D)
      if (fingerCount >= 1 && fingerCount <= 4) {
        const choiceIdx = fingerCount - 1;
        const choiceLetter = ['A', 'B', 'C', 'D'][choiceIdx];
        const choiceIcon = ['☝️', '✌️', '🤟', '🖖'][choiceIdx];

        updateGestureLiveHUD(choiceIdx, `${choiceIcon} ${fingerCount} JARI = JAWAPAN [${choiceLetter}]`, choiceIcon);
        handleStableCandidateHolding(choiceIdx);
      } else if (fingerCount === 5) {
        updateGestureLiveHUD(null, "✋ 5 Jari (Tapak Terbuka). Sila tunjukkan 1 hingga 4 jari untuk memilih jawapan.", "✋");
        resetCandidate();
      } else {
        updateGestureLiveHUD(null, "Tangan digenggam. Angkat 1 hingga 4 jari untuk memilih A, B, C atau D.", "✊");
        resetCandidate();
      }
    }

    function countExtendedFingers(lm) {
      let count = 0;

      // Jari Telunjuk: tip (8) lebih tinggi daripada pip (6)
      if (lm[8].y < lm[6].y) count++;

      // Jari Hantu / Tengah: tip (12) lebih tinggi daripada pip (10)
      if (lm[12].y < lm[10].y) count++;

      // Jari Manis: tip (16) lebih tinggi daripada pip (14)
      if (lm[16].y < lm[14].y) count++;

      // Jari Kelingking: tip (20) lebih tinggi daripada pip (18)
      if (lm[20].y < lm[18].y) count++;

      return count;
    }

    function handleStableCandidateHolding(choiceIdx) {
      const now = performance.now();

      if (candidateChoice === choiceIdx) {
        const elapsed = now - candidateStartTime;
        const percent = Math.min(100, Math.round((elapsed / GESTURE_HOLD_DURATION_MS) * 100));

        updateHoldProgress(percent);

        if (elapsed >= GESTURE_HOLD_DURATION_MS) {
          // Kestabilan 1 saat dicapai -> Hantar jawapan secara automatik!
          const finalChoice = choiceIdx;
          candidateChoice = null;
          candidateStartTime = 0;
          resetGestureProgressBar();

          // Panggil fungsi semakan jawapan rasmi
          handleSelectOption(finalChoice);
        }
      } else {
        // Isyarat baru dikesan, mulakan pengiraan masa kestabilan
        candidateChoice = choiceIdx;
        candidateStartTime = now;
        updateHoldProgress(5);
      }
    }

    function resetCandidate() {
      candidateChoice = null;
      candidateStartTime = 0;
      resetGestureProgressBar();
    }

    function resetGestureProgressBar() {
      updateHoldProgress(0);
    }

    function updateHoldProgress(pct) {
      const bar = document.getElementById('gesture-hold-bar');
      const text = document.getElementById('gesture-hold-percent');
      if (bar) bar.style.width = `${pct}%`;
      if (text) text.innerText = `${pct}%`;
    }

    function updateGestureLiveHUD(choiceIdx, labelText, iconText) {
      const lbl = document.getElementById('gesture-current-label');
      const icn = document.getElementById('gesture-current-icon');
      if (lbl) lbl.innerText = labelText;
      if (icn) icn.innerText = iconText;

      // Serlahkan kad pilihan yang sedang dikesan seketika
      for (let i = 0; i < 4; i++) {
        const btn = document.getElementById(`opt-btn-${i}`);
        if (btn && !isQuestionAnswered) {
          if (i === choiceIdx) {
            btn.classList.add('ring-2', 'ring-amber-400', 'bg-amber-50');
          } else {
            btn.classList.remove('ring-2', 'ring-amber-400', 'bg-amber-50');
          }
        }
      }
    }

    function enterLevel(lvl) {
      if (!gameState.unlockedLevels.includes(lvl)) {
        soundManager.playWrong();
        return;
      }
      soundManager.playClick();
      currentLevel = lvl;
      currentQIndex = 0;
      currentLevelScore = 0;
      currentLevelQuestions = [...QUESTION_BANK[lvl]];

      const stageInfo = STAGE_TITLES[lvl];
      document.getElementById('game-location-tag').innerText = stageInfo.tag;
      document.getElementById('game-stage-title').innerText = stageInfo.desc;

      showScreen('screen-game');
      renderQuestion();
      setAnswerMode(currentAnswerMode);
    }

    function confirmExitLevel() {
      soundManager.playClick();
      stopBackgroundGestureTracking();
      showScreen('screen-levels');
    }

    function renderQuestion() {
      isQuestionAnswered = false;
      resetCandidate();
      const qData = currentLevelQuestions[currentQIndex];

      const expBox = document.getElementById('explanation-box');
      expBox.classList.add('hidden');

      document.getElementById('current-q-num').innerText = currentQIndex + 1;
      document.getElementById('level-score-counter').innerText = `${currentLevelScore}/10`;
      
      const percent = ((currentQIndex) / 10) * 100;
      document.getElementById('game-progress-bar').style.width = `${percent}%`;

      document.getElementById('question-scenario').innerText = `"${qData.scenario}"`;

      const arabBox = document.getElementById('question-arabic-box');
      if (qData.arabicText) {
        arabBox.classList.remove('hidden');
        document.getElementById('question-arabic-text').innerText = qData.arabicText;
        document.getElementById('question-arabic-sub').innerText = qData.arabicSub || '';
      } else {
        arabBox.classList.add('hidden');
      }

      document.getElementById('question-main-text').innerText = qData.q;

      const optionsContainer = document.getElementById('options-container');
      optionsContainer.innerHTML = '';

      const optionLabels = ['A', 'B', 'C', 'D'];
      const gestureSymbols = ['☝️ [A] 1 Jari', '✌️ [B] 2 Jari', '🤟 [C] 3 Jari', '🖖 [D] 4 Jari'];

      qData.options.forEach((optText, idx) => {
        const btn = document.createElement('button');
        btn.className = "btn-3d w-full p-3.5 rounded-2xl border-2 border-slate-200 bg-white hover:bg-emerald-50 hover:border-emerald-300 text-left transition flex items-center space-x-3 text-xs md:text-sm shadow-sm";
        btn.id = `opt-btn-${idx}`;
        btn.onclick = () => handleSelectOption(idx);

        const isGest = (currentAnswerMode === 'gesture');
        const badgeClass = isGest
          ? "px-2.5 py-1 rounded-xl bg-amber-100 text-amber-900 font-black text-xs flex-shrink-0 border-2 border-amber-300 shadow-sm"
          : "w-7 h-7 rounded-xl bg-slate-100 text-slate-700 font-bold flex items-center justify-center text-xs flex-shrink-0 border border-slate-300";
        const badgeLabel = isGest ? gestureSymbols[idx] : optionLabels[idx];

        btn.innerHTML = `
          <span id="opt-label-${idx}" class="${badgeClass}">
            ${badgeLabel}
          </span>
          <span class="font-medium text-slate-800 leading-snug">${optText}</span>
        `;
        optionsContainer.appendChild(btn);
      });
    }

    function handleSelectOption(selectedIdx) {
      if (isQuestionAnswered) return;
      isQuestionAnswered = true; // Kunci supaya jawapan tidak dihantar berulang kali
      resetCandidate();

      const qData = currentLevelQuestions[currentQIndex];
      const isCorrect = (selectedIdx === qData.correct);

      // Kunci dan tandakan pilihan butang teks
      qData.options.forEach((_, idx) => {
        const btn = document.getElementById(`opt-btn-${idx}`);
        if (btn) {
          btn.disabled = true;
          btn.classList.remove('hover:bg-emerald-50', 'hover:border-emerald-300', 'ring-2', 'ring-amber-400');

          if (idx === qData.correct) {
            btn.className = "w-full p-3.5 rounded-2xl border-2 border-emerald-500 bg-emerald-100 text-emerald-950 font-bold text-left flex items-center space-x-3 shadow-md";
            const iconSpan = btn.querySelector('span');
            if (iconSpan) {
              iconSpan.className = "w-7 h-7 rounded-xl bg-emerald-600 text-white font-black flex items-center justify-center text-xs flex-shrink-0";
              iconSpan.innerText = "✓";
            }
          } else if (idx === selectedIdx && !isCorrect) {
            btn.className = "w-full p-3.5 rounded-2xl border-2 border-rose-400 bg-rose-100 text-rose-950 font-medium text-left flex items-center space-x-3";
            const iconSpan = btn.querySelector('span');
            if (iconSpan) {
              iconSpan.className = "w-7 h-7 rounded-xl bg-rose-500 text-white font-black flex items-center justify-center text-xs flex-shrink-0";
              iconSpan.innerText = "✕";
            }
          } else {
            btn.classList.add('opacity-50');
          }
        }
      });

      if (isCorrect) {
        soundManager.playCorrect();
        currentLevelScore++;
        gameState.coins += 10;
        soundManager.playCoin();
        updateHeaderUI();
      } else {
        soundManager.playWrong();
      }

      const expBox = document.getElementById('explanation-box');
      const expTitle = document.getElementById('explanation-title');
      const expText = document.getElementById('explanation-text');

      expBox.classList.remove('hidden');
      if (isCorrect) {
        expBox.className = "mt-4 p-4 rounded-2xl border-2 border-emerald-300 bg-emerald-50/90 text-xs md:text-sm";
        expTitle.innerHTML = `<span class="text-emerald-700">✓ Tepat Sekali! Penjelasan Ustaz Faris:</span>`;
      } else {
        expBox.className = "mt-4 p-4 rounded-2xl border-2 border-rose-300 bg-rose-50/90 text-xs md:text-sm";
        expTitle.innerHTML = `<span class="text-rose-700">✕ Kurang Tepat. Penerangan Ustaz Faris:</span>`;
      }
      expText.innerText = qData.explanation;

      const btnNext = document.getElementById('btn-next-question');
      if (currentQIndex === 9) {
        btnNext.innerHTML = `<span>Lihat Keputusan Tahap</span> <span>🏆</span>`;
      } else {
        btnNext.innerHTML = `<span>Soalan Seterusnya</span> <span>➔</span>`;
      }
    }

    function proceedNextQuestion() {
      soundManager.playClick();
      if (currentQIndex < 9) {
        currentQIndex++;
        renderQuestion();
      } else {
        finishLevelSummary();
      }
    }

    function finishLevelSummary() {
      stopBackgroundGestureTracking();
      const isPassed = (currentLevelScore === 10);
      showScreen('screen-result');

      const iconContainer = document.getElementById('result-icon-container');
      const titleEl = document.getElementById('result-title');
      const subEl = document.getElementById('result-subtitle');
      const scoreDisplay = document.getElementById('result-score-display');
      const statusTag = document.getElementById('result-status-tag');
      const rewardCoins = document.getElementById('result-reward-coins');
      const badgeBox = document.getElementById('result-badge-container');
      const reqNote = document.getElementById('result-requirement-note');
      const btnNext = document.getElementById('btn-result-next');
      const btnRetry = document.getElementById('btn-result-retry');

      scoreDisplay.innerText = `${currentLevelScore} / 10`;

      if (isPassed) {
        soundManager.playLevelComplete();
        iconContainer.innerText = '🏆';
        titleEl.innerText = `Tahniah! Tahap ${currentLevel} Selesai Sempurna!`;
        subEl.innerText = `Hebat! Anda menguasai semua 10 soalan ${STAGE_TITLES[currentLevel].name}.`;
        
        statusTag.className = "text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800";
        statusTag.innerText = "LULUS CEMERLANG (10/10)";
        
        rewardCoins.innerText = "+100 🪙";
        gameState.coins += 100;

        if (!gameState.completedLevels.includes(currentLevel)) {
          gameState.completedLevels.push(currentLevel);
        }

        const nextLvl = currentLevel + 1;
        if (nextLvl <= 5 && !gameState.unlockedLevels.includes(nextLvl)) {
          gameState.unlockedLevels.push(nextLvl);
        }

        const badgeInfo = BADGES[currentLevel];
        if (badgeInfo && !gameState.badges.includes(currentLevel)) {
          gameState.badges.push(currentLevel);
          soundManager.playBadge();
          badgeBox.classList.remove('hidden');
          document.getElementById('result-badge-icon').innerText = badgeInfo.icon;
          document.getElementById('result-badge-name').innerText = badgeInfo.name;
          document.getElementById('result-badge-desc').innerText = badgeInfo.desc;
        } else {
          badgeBox.classList.add('hidden');
        }

        reqNote.classList.add('hidden');
        btnNext.classList.remove('hidden');
        btnRetry.innerText = "Ulang Kaji Semula";
        btnRetry.className = "btn-3d flex-1 py-3 bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold text-xs md:text-sm rounded-xl shadow";

        saveGame();

        if (gameState.completedLevels.length === 5) {
          btnNext.innerHTML = `<span>👑 Lihat Sijil Kejayaan Akhir</span>`;
          btnNext.onclick = showVictoryScreen;
        } else {
          btnNext.innerHTML = `<span>📋 Teruskan ke Pilihan Tahap</span>`;
          btnNext.onclick = () => showScreen('screen-levels');
        }

      } else {
        soundManager.playWrong();
        iconContainer.innerText = '📖';
        titleEl.innerText = `Teruskan Usaha!`;
        subEl.innerText = `Anda memperoleh ${currentLevelScore} markah. Sukatan memerlukan ketepatan 10/10 untuk melengkapkan tahap ini.`;
        
        statusTag.className = "text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-800";
        statusTag.innerText = "BELUM LULUS (PERLU 10/10)";
        
        rewardCoins.innerText = "+0 🪙";
        badgeBox.classList.add('hidden');
        reqNote.classList.remove('hidden');

        btnRetry.className = "btn-3d flex-1 py-3 bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold text-xs md:text-sm rounded-xl shadow animate-pulse";
        btnRetry.innerText = "🔄 Cuba Lagi (10/10)";

        btnNext.classList.remove('hidden');
        btnNext.innerHTML = `<span>📚 Buka Nota Pembelajaran</span>`;
        btnNext.onclick = () => openModal('modal-notes');

        saveGame();
      }
    }

    function retryCurrentLevel() {
      enterLevel(currentLevel);
    }

    function proceedToNextLevelFromSummary() {
      showScreen('screen-levels');
    }

    function showVictoryScreen() {
      soundManager.playLevelComplete();
      showScreen('screen-victory');

      document.getElementById('victory-total-coins').innerText = `${gameState.coins} 🪙`;

      const listContainer = document.getElementById('victory-badges-list');
      listContainer.innerHTML = '';

      for (let i = 1; i <= 5; i++) {
        const b = BADGES[i];
        const div = document.createElement('div');
        div.className = "p-2 bg-white rounded-xl border-2 border-amber-300 shadow-sm flex flex-col items-center text-center";
        div.innerHTML = `
          <span class="text-3xl mb-1">${b.icon}</span>
          <span class="text-[10px] font-bold text-slate-800 leading-tight">${b.name}</span>
          <span class="text-[9px] text-emerald-700 font-semibold mt-0.5">Tahap ${i} Selesai</span>
        `;
        listContainer.appendChild(div);
      }
    }

    /* ==========================================================================
       6. MOD CABARAN KILAT BERMASA (AKTIVITI PILIHAN)
       ========================================================================== */
    let bonusTimer = null;
    let bonusTimeLeft = 30;
    let bonusCoinsEarned = 0;
    let bonusQuestionList = [];

    function openBonusMode() {
      soundManager.playClick();
      bonusTimeLeft = 30;
      bonusCoinsEarned = 0;
      
      bonusQuestionList = [];
      for (let i = 1; i <= 5; i++) {
        bonusQuestionList.push(...QUESTION_BANK[i]);
      }
      bonusQuestionList.sort(() => Math.random() - 0.5);

      document.getElementById('bonus-timer-display').innerText = `${bonusTimeLeft}s`;
      document.getElementById('bonus-score-display').innerText = `+0 🪙`;
      document.getElementById('bonus-quiz-body').classList.remove('hidden');
      document.getElementById('bonus-gameover-body').classList.add('hidden');

      showScreen('screen-bonus');
      renderBonusQuestion();

      if (bonusTimer) clearInterval(bonusTimer);
      bonusTimer = setInterval(() => {
        bonusTimeLeft--;
        const el = document.getElementById('bonus-timer-display');
        if (el) el.innerText = `${bonusTimeLeft}s`;

        if (bonusTimeLeft <= 0) {
          clearInterval(bonusTimer);
          endBonusMode();
        }
      }, 1000);
    }

    function renderBonusQuestion() {
      if (bonusQuestionList.length === 0) {
        endBonusMode();
        return;
      }
      const q = bonusQuestionList.pop();
      document.getElementById('bonus-question-text').innerText = q.q;

      const cont = document.getElementById('bonus-options-container');
      cont.innerHTML = '';

      q.options.forEach((opt, idx) => {
        const btn = document.createElement('button');
        btn.className = "btn-3d p-3 bg-amber-50 hover:bg-amber-100 border border-amber-300 rounded-xl text-left text-xs font-semibold text-slate-800 transition";
        btn.innerText = opt;
        btn.onclick = () => {
          if (idx === q.correct) {
            soundManager.playCoin();
            bonusCoinsEarned += 20;
            gameState.coins += 20;
            document.getElementById('bonus-score-display').innerText = `+${bonusCoinsEarned} 🪙`;
            updateHeaderUI();
          } else {
            soundManager.playWrong();
          }
          renderBonusQuestion();
        };
        cont.appendChild(btn);
      });
    }

    function endBonusMode() {
      if (bonusTimer) clearInterval(bonusTimer);
      soundManager.playBadge();
      document.getElementById('bonus-quiz-body').classList.add('hidden');
      document.getElementById('bonus-gameover-body').classList.remove('hidden');
      document.getElementById('bonus-final-summary').innerText = `Hebat! Anda mengumpul ${bonusCoinsEarned} syiling bonus dalam masa 30 saat!`;
      saveGame();
    }

    /* ==========================================================================
       7. SISTEM MODAL & NOTA PEMBELAJARAN
       ========================================================================== */
    function openModal(modalId) {
      soundManager.playClick();
      const el = document.getElementById(modalId);
      if (el) el.classList.remove('hidden');
    }

    function closeModal(modalId) {
      soundManager.playClick();
      const el = document.getElementById(modalId);
      if (el) el.classList.add('hidden');
    }

    function switchNoteTab(tabId) {
      soundManager.playClick();
      const tabs = ['tab-pengertian', 'tab-dalil', 'tab-rukun', 'tab-syarat', 'tab-hukum'];
      tabs.forEach(t => {
        const c = document.getElementById(t);
        const b = document.getElementById(`btn-${t}`);
        if (c) c.classList.add('hidden');
        if (b) {
          b.className = "px-3 py-1.5 rounded-xl bg-teal-100 text-teal-800 hover:bg-teal-200 transition flex-shrink-0";
        }
      });
      const targetContent = document.getElementById(tabId);
      const targetBtn = document.getElementById(`btn-${tabId}`);
      if (targetContent) targetContent.classList.remove('hidden');
      if (targetBtn) {
        targetBtn.className = "px-3 py-1.5 rounded-xl bg-teal-700 text-white transition flex-shrink-0";
      }
    }

    function openOriginalRefHelper() {
      openModal('modal-original-ref');
    }

    /* ==========================================================================
       8. TETAPAN AUDIO & KELANTANGAN
       ========================================================================== */
    function toggleBgmSetting() {
      gameState.soundSettings.bgm = !gameState.soundSettings.bgm;
      applySoundSettings();
      saveGame();
    }

    function toggleSfxSetting() {
      gameState.soundSettings.sfx = !gameState.soundSettings.sfx;
      applySoundSettings();
      saveGame();
    }

    function changeVolumeSetting(val) {
      const num = parseInt(val, 10) / 100;
      gameState.soundSettings.volume = num;
      document.getElementById('volume-label').innerText = `${val}%`;
      soundManager.setMasterVolume(num);
      saveGame();
    }

    function applySoundSettings() {
      soundManager.musicEnabled = gameState.soundSettings.bgm;
      soundManager.sfxEnabled = gameState.soundSettings.sfx;
      soundManager.setMasterVolume(gameState.soundSettings.volume);

      const btnBgm = document.getElementById('toggle-bgm');
      const btnSfx = document.getElementById('toggle-sfx');

      if (btnBgm) {
        btnBgm.innerText = gameState.soundSettings.bgm ? "HIDUP" : "MATI";
        btnBgm.className = gameState.soundSettings.bgm
          ? "px-4 py-1.5 rounded-full font-bold text-xs bg-emerald-600 text-white transition"
          : "px-4 py-1.5 rounded-full font-bold text-xs bg-slate-300 text-slate-700 transition";
      }

      if (btnSfx) {
        btnSfx.innerText = gameState.soundSettings.sfx ? "HIDUP" : "MATI";
        btnSfx.className = gameState.soundSettings.sfx
          ? "px-4 py-1.5 rounded-full font-bold text-xs bg-emerald-600 text-white transition"
          : "px-4 py-1.5 rounded-full font-bold text-xs bg-slate-300 text-slate-700 transition";
      }

      if (gameState.soundSettings.bgm && !soundManager.bgmPlaying) {
        soundManager.startBgm();
      } else if (!gameState.soundSettings.bgm && soundManager.bgmPlaying) {
        soundManager.stopBgm();
      }
    }

    /* ==========================================================================
       9. PERMULAAN APLIKASI
       ========================================================================== */
    window.onload = function() {
      loadSavedGame();
      document.body.addEventListener('click', function unlockAudio() {
        soundManager.init();
        document.body.removeEventListener('click', unlockAudio);
      }, { once: true });
    };
  </script>
</body>
