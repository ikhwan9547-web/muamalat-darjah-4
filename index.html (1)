    /* ==========================================================================
       1. ENJIN AUDIO SINTESIS WEB AUDIO API
       ========================================================================== */
    class AlBaiAudioEngine {
      constructor() {
        this.ctx = null;
        this.bgmPlaying = false;
        this.bgmInterval = null;
        this.musicEnabled = true;
        this.sfxEnabled = true;
        this.masterVolume = 0.7;
      }

      init() {
        if (!this.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AudioContext();
        }
        if (this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      playTone(freq, type = 'sine', duration = 0.2, gainValue = 0.2) {
        if (!this.sfxEnabled) return;
        this.init();
        try {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = type;
          osc.frequency.setValueAtTime(freq, this.ctx.currentTime);

          gain.gain.setValueAtTime(gainValue * this.masterVolume, this.ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.0001, this.ctx.currentTime + duration);

          osc.connect(gain);
          gain.connect(this.ctx.destination);

          osc.start();
          osc.stop(this.ctx.currentTime + duration);
        } catch (e) {
          console.debug("Audio playTone error", e);
        }
      }

      playClick() {
        this.playTone(520, 'triangle', 0.08, 0.2);
      }

      playCorrect() {
        if (!this.sfxEnabled) return;
        this.init();
        const notes = [523.25, 659.25, 783.99, 1046.50];
        notes.forEach((freq, idx) => {
          setTimeout(() => {
            this.playTone(freq, 'sine', 0.25, 0.25);
          }, idx * 75);
        });
      }

      playWrong() {
        if (!this.sfxEnabled) return;
        this.init();
        this.playTone(260, 'sawtooth', 0.2, 0.15);
        setTimeout(() => this.playTone(220, 'sawtooth', 0.3, 0.15), 120);
      }

      playCoin() {
        if (!this.sfxEnabled) return;
        this.init();
        this.playTone(987.77, 'sine', 0.1, 0.25);
        setTimeout(() => this.playTone(1318.51, 'triangle', 0.2, 0.25), 80);
      }

      playBadge() {
        if (!this.sfxEnabled) return;
        this.init();
        const fanfares = [440, 554.37, 659.25, 880];
        fanfares.forEach((f, i) => {
          setTimeout(() => this.playTone(f, 'triangle', 0.35, 0.3), i * 110);
        });
      }

      playLevelComplete() {
        if (!this.sfxEnabled) return;
        this.init();
        const mel = [523, 659, 783, 1046, 1318];
        mel.forEach((f, i) => {
          setTimeout(() => this.playTone(f, 'sine', 0.4, 0.3), i * 120);
        });
      }

      startBgm() {
        if (!this.musicEnabled || this.bgmPlaying) return;
        this.init();
        this.bgmPlaying = true;
        const scale = [293.66, 311.13, 369.99, 392.00, 440.00, 466.16, 523.25];
        let step = 0;

        const loopMusic = () => {
          if (!this.bgmPlaying || !this.musicEnabled) return;
          try {
            const noteFreq = scale[step % scale.length];
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();

            osc.type = 'triangle';
            osc.frequency.setValueAtTime(noteFreq, this.ctx.currentTime);

            const vol = 0.04 * this.masterVolume;
            gain.gain.setValueAtTime(vol, this.ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.0001, this.ctx.currentTime + 0.35);

            osc.connect(gain);
            gain.connect(this.ctx.destination);

            osc.start();
            osc.stop(this.ctx.currentTime + 0.35);

            step = (step + (Math.random() > 0.4 ? 1 : 2)) % scale.length;
          } catch (e) {
            console.debug("BGM tick error", e);
          }
        };

        this.bgmInterval = setInterval(loopMusic, 420);
      }

      stopBgm() {
        this.bgmPlaying = false;
        if (this.bgmInterval) {
          clearInterval(this.bgmInterval);
          this.bgmInterval = null;
        }
      }

      setMasterVolume(val) {
        this.masterVolume = Math.max(0, Math.min(1, val));
      }
    }

