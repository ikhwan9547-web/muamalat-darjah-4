    const STORAGE_KEY = 'AL_BAI_MUAMALAT_D4_DATA_V2';

    let gameState = {
      unlockedLevels: [1],
      completedLevels: [],
      coins: 0,
      badges: [],
      soundSettings: {
        bgm: true,
        sfx: true,
        volume: 0.7
      }
