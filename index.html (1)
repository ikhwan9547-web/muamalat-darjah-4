<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AL-BAI‘ — MUAMALAT DARJAH 4 | Kuiz Interaktif Pelajaran 1: Jual Beli</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Amiri:ital,wght@0,400;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            emeraldPrimary: '#059669',
            emeraldDark: '#064e3b',
            emeraldLight: '#10b981',
            creamSoft: '#fdfbf7',
            creamCard: '#fffbeb',
            goldWarm: '#f59e0b',
            goldAccent: '#d97706',
            turquoiseSoft: '#0d9488',
            turquoiseLight: '#14b8a6',
            sandBg: '#fef3c7'
          },
          fontFamily: {
            title: ['"Fredoka"', 'sans-serif'],
            arabic: ['"Amiri"', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'sans-serif']
          },
          boxShadow: {
            'game': '0 6px 0 0 rgba(4, 120, 87, 0.9), 0 10px 20px -5px rgba(0, 0, 0, 0.25)',
            'game-gold': '0 6px 0 0 rgba(180, 83, 9, 0.9), 0 10px 20px -5px rgba(245, 158, 11, 0.35)',
            'game-pressed': '0 2px 0 0 rgba(4, 120, 87, 0.9), 0 4px 6px -1px rgba(0, 0, 0, 0.2)',
            'card-soft': '0 10px 30px -10px rgba(6, 78, 59, 0.15)'
          }
        }
      }
    }
  </script>

  <style>
    @keyframes floatSoft {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-6px); }
    }
    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 12px rgba(245, 158, 11, 0.3); }
      50% { box-shadow: 0 0 24px rgba(245, 158, 11, 0.7); }
    }
    .animate-float {
      animation: floatSoft 3.2s ease-in-out infinite;
    }
    .btn-3d {
      transition: all 0.12s ease;
    }
    .btn-3d:active {
      transform: translateY(3px);
    }
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #fdfbf7;
    }
    ::-webkit-scrollbar-thumb {
      background: #10b981;
      border-radius: 9999px;
    }
  </style>
</head>
<body class="bg-[#f7f5eb] text-slate-800 font-sans min-h-screen flex flex-col select-none overflow-x-hidden">

  <header class="bg-gradient-to-r from-emeraldDark via-emeraldPrimary to-turquoiseSoft text-white shadow-lg sticky top-0 z-40 border-b-4 border-goldWarm">
    <div class="max-w-6xl mx-auto px-4 py-2.5 flex items-center justify-between">
      <div class="flex items-center space-x-3 cursor-pointer" onclick="showScreen('screen-home')">
        <div class="w-10 h-10 rounded-2xl bg-amber-400 flex items-center justify-center text-2xl shadow-inner transform -rotate-3 hover:rotate-0 transition">
          📖
        </div>
        <div>
          <h1 class="font-title font-bold text-lg md:text-xl tracking-wide leading-tight text-amber-200">
            AL-BAI‘
          </h1>
          <p class="text-[10px] md:text-xs text-emerald-100 font-medium">MUAMALAT DARJAH 4 • Kuiz Pelajaran 1 (Jual Beli)</p>
        </div>
      </div>

      <div class="flex items-center space-x-2 md:space-x-3">
        <div class="flex items-center bg-black/25 backdrop-blur-sm px-2.5 py-1 rounded-full border border-amber-300/40 text-amber-300 font-bold text-xs md:text-sm shadow-inner" title="Jumlah Syiling">
          <span class="mr-1 text-base animate-bounce">🪙</span>
          <span id="header-coins">0</span>
        </div>

        <div class="hidden sm:flex items-center bg-black/25 backdrop-blur-sm px-2.5 py-1 rounded-full border border-emerald-300/40 text-emerald-200 font-bold text-xs md:text-sm" title="Lencana Pembelajaran">
          <span class="mr-1 text-base">🏅</span>
          <span id="header-badges">0/5</span>
        </div>

        <button onclick="showScreen('screen-levels')" class="bg-emerald-700/80 hover:bg-emerald-600 px-2.5 py-1.5 rounded-xl text-white transition flex items-center space-x-1 text-xs font-semibold" title="Pilih Tahap">
          <span>📋</span>
          <span class="hidden md:inline">Pilih Tahap</span>
        </button>

        <button onclick="openModal('modal-notes')" class="bg-teal-700/80 hover:bg-teal-600 px-2.5 py-1.5 rounded-xl text-white transition flex items-center space-x-1 text-xs font-semibold" title="Nota Pembelajaran">
          <span>📚</span>
          <span class="hidden md:inline">Nota</span>
        </button>

        <button onclick="openModal('modal-manual')" class="bg-amber-600/80 hover:bg-amber-500 px-2.5 py-1.5 rounded-xl text-white transition flex items-center space-x-1 text-xs font-semibold" title="Manual Pengguna">
          <span>📖</span>
          <span class="hidden md:inline">Manual</span>
        </button>

        <button onclick="openModal('modal-settings')" class="bg-emerald-900/80 hover:bg-emerald-800 p-2 rounded-xl text-emerald-100 transition" title="Tetapan Audio">
          ⚙️
        </button>
      </div>
    </div>
  </header>

  <main class="flex-grow flex items-center justify-center p-3 md:p-6 relative max-w-6xl mx-auto w-full">

    <!-- 1. SKRIN UTAMA (HOME) -->
    <section id="screen-home" class="w-full max-w-3xl flex flex-col items-center text-center py-4">
      <div class="relative w-full max-w-2xl mx-auto mb-5">
        <div class="bg-gradient-to-b from-emerald-800 via-emerald-700 to-teal-900 p-6 md:p-8 rounded-3xl text-white border-4 border-amber-400 shadow-2xl relative overflow-hidden">
          <div class="absolute -top-10 -right-10 w-40 h-40 bg-amber-400/20 rounded-full blur-2xl"></div>
          <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-emerald-400/20 rounded-full blur-2xl"></div>

          <!-- Watak Tunggal: Ustaz Faris -->
          <div class="flex justify-center items-center mb-3">
            <div class="flex flex-col items-center animate-float">
              <div class="w-24 h-24 md:w-28 md:h-28 bg-emerald-100 rounded-full border-4 border-amber-400 shadow-xl flex items-center justify-center text-5xl md:text-6xl">
                👳‍♂️
              </div>
              <span class="text-xs md:text-sm bg-amber-500 text-slate-900 px-3 py-0.5 rounded-full mt-2 font-bold shadow">
                Ustaz Faris (Guru Pembimbing)
              </span>
            </div>
          </div>

          <h2 class="font-title text-3xl md:text-5xl font-black text-amber-300 tracking-wide drop-shadow-md">
            AL-BAI‘
          </h2>
          <h3 class="font-title text-lg md:text-2xl font-bold text-emerald-100 mt-1">
            MUAMALAT DARJAH 4
          </h3>
          <p class="font-arabic text-xl md:text-2xl text-amber-200 mt-2">كِتَابُ البَيْعِ — فِقْهُ المُعَامَلَاتِ</p>
          <div class="inline-block bg-emerald-950/70 border border-emerald-400/40 rounded-full px-4 py-1 text-xs md:text-sm font-semibold text-emerald-200 mt-3 shadow">
            Kuiz Interaktif: Pelajaran 1 — Jual Beli (SAKNJ)
          </div>
        </div>
      </div>

      <div class="w-full max-w-2xl bg-white border-2 border-emerald-200 rounded-2xl p-5 shadow-card-soft mb-6 text-left flex items-start space-x-4">
        <div class="text-4xl flex-shrink-0 bg-emerald-100 p-2.5 rounded-2xl">
          🕌
        </div>
        <div>
          <h4 class="font-title font-bold text-emerald-900 text-base md:text-lg flex items-center">
            <span>Pesanan Ustaz Faris:</span>
            <span class="ml-2 text-[10px] bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-bold">Ulang Kaji Muamalat</span>
          </h4>
          <p class="text-xs md:text-sm text-slate-700 mt-1.5 leading-relaxed">
            “Assalamualaikum! Selamat datang ke kuiz Muamalat Darjah 4. Bersama Ustaz Faris, mari kita ulang kaji Pelajaran 1: Jual Beli. Jawab soalan tentang pengertian, dalil, rukun, syarat dan hukum jual beli berdasarkan nota pembelajaran. Kumpulkan markah dan lengkapkan kelima-lima tahap!”
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 w-full max-w-xl">
        <button onclick="startGame()" class="btn-3d w-full bg-gradient-to-b from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-500 text-slate-900 font-title font-black text-base md:text-lg py-3.5 px-6 rounded-2xl shadow-game-gold flex items-center justify-center space-x-2 border-t-2 border-amber-200">
          <span>🚀</span>
          <span>MULA KUIZ</span>
        </button>

        <button onclick="showScreen('screen-levels')" class="btn-3d w-full bg-gradient-to-b from-emerald-600 to-emerald-700 hover:from-emerald-500 hover:to-emerald-700 text-white font-title font-bold text-base md:text-lg py-3.5 px-6 rounded-2xl shadow-game flex items-center justify-center space-x-2 border-t-2 border-emerald-400">
          <span>📋</span>
          <span>PILIH TAHAP</span>
        </button>

        <button onclick="openModal('modal-notes')" class="btn-3d w-full bg-white hover:bg-teal-50 text-teal-800 border-2 border-teal-500 font-title font-bold text-sm py-3 px-4 rounded-2xl shadow-sm flex items-center justify-center space-x-2">
          <span>📚</span>
          <span>NOTA PEMBELAJARAN</span>
        </button>

        <button onclick="openModal('modal-manual')" class="btn-3d w-full bg-white hover:bg-amber-50 text-amber-900 border-2 border-amber-500 font-title font-bold text-sm py-3 px-4 rounded-2xl shadow-sm flex items-center justify-center space-x-2">
          <span>📖</span>
          <span>MANUAL PENGGUNA</span>
        </button>
      </div>

      <div class="flex items-center justify-center gap-3 mt-5 text-xs text-slate-500">
        <button onclick="openModal('modal-settings')" class="hover:text-emerald-700 font-semibold underline flex items-center">
          ⚙️ Tetapan Audio
        </button>
        <span>•</span>
        <button onclick="openBonusMode()" class="hover:text-amber-700 font-semibold underline flex items-center">
          ⚡ Cabaran Kilat (Bonus)
        </button>
      </div>
    </section>

    <!-- 2. SKRIN PILIHAN 5 TAHAP KUIZ -->
    <section id="screen-levels" class="hidden w-full max-w-4xl flex-col items-center">
      <div class="w-full bg-white border-2 border-emerald-200 rounded-2xl p-4 shadow-md mb-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <div class="flex items-center space-x-2">
            <span class="text-2xl">📋</span>
            <h2 class="font-title font-bold text-xl text-emerald-900">Pilih Tahap Kuiz Muamalat</h2>
          </div>
          <p class="text-xs text-slate-600 mt-0.5">Selesaikan setiap tahap dengan markah 10/10 untuk menguasai topik Jual Beli.</p>
        </div>
        
        <div class="flex items-center space-x-3 bg-emerald-50 px-4 py-2 rounded-xl border border-emerald-200">
          <div class="text-left">
            <div class="text-[10px] text-emerald-700 font-bold uppercase">Kemajuan Keseluruhan</div>
            <div class="text-sm font-black text-emerald-900" id="levels-progress-text">0 / 5 Tahap (0%)</div>
          </div>
          <div class="w-24 bg-emerald-200 h-3 rounded-full overflow-hidden">
            <div id="levels-progress-bar" class="bg-emerald-600 h-full w-0 transition-all duration-500"></div>
          </div>
        </div>
      </div>

      <!-- Kad 5 Tahap Kuiz Pembelajaran -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full mb-5">

        <!-- Kad Tahap 1 -->
        <div id="card-stage-1" class="bg-white rounded-2xl p-5 border-2 border-emerald-400 shadow-md flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-3xl p-2 bg-emerald-100 rounded-xl">📖</span>
              <span id="badge-stage-1" class="text-xs font-bold px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-300">
                Tahap 1
              </span>
            </div>
            <h3 class="font-title font-bold text-slate-900 text-lg mt-3">Tahap 1 — Pengertian Jual Beli</h3>
            <p class="text-xs text-slate-600 mt-1">Takrif jual beli dari segi Bahasa dan Syarak serta konsep asas pertukaran harta.</p>
          </div>
          <div class="flex items-center justify-between pt-3 mt-3 border-t border-slate-100">
            <span id="status-stage-1" class="text-xs font-bold text-emerald-600">● Terbuka</span>
            <button onclick="enterLevel(1)" class="btn-3d px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl shadow">
              Mula Kuiz ➔
            </button>
          </div>
        </div>

        <!-- Kad Tahap 2 -->
        <div id="card-stage-2" class="bg-white rounded-2xl p-5 border-2 border-slate-200 shadow-md flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-3xl p-2 bg-amber-100 rounded-xl">📜</span>
              <span id="badge-stage-2" class="text-xs font-bold px-3 py-1 rounded-full bg-slate-200 text-slate-600">
                Tahap 2
              </span>
            </div>
            <h3 class="font-title font-bold text-slate-900 text-lg mt-3">Tahap 2 — Dalil Jual Beli</h3>
            <p class="text-xs text-slate-600 mt-1">Surah al-Baqarah ayat 275, terjemahan, penghalalan jual beli dan pengharaman riba.</p>
          </div>
          <div class="flex items-center justify-between pt-3 mt-3 border-t border-slate-100">
            <span id="status-stage-2" class="text-xs font-bold text-slate-500">🔒 Terkunci</span>
            <button id="btn-stage-2" onclick="enterLevel(2)" class="btn-3d px-4 py-2 bg-slate-300 text-slate-500 font-bold text-xs rounded-xl cursor-not-allowed">
              Kunci 🔒
            </button>
          </div>
        </div>

        <!-- Kad Tahap 3 -->
        <div id="card-stage-3" class="bg-white rounded-2xl p-5 border-2 border-teal-400 shadow-md flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-3xl p-2 bg-teal-100 rounded-xl">⚖️</span>
              <span id="badge-stage-3" class="text-xs font-bold px-3 py-1 rounded-full bg-teal-100 text-teal-800 border border-teal-300">
                Tahap 3
              </span>
            </div>
            <h3 class="font-title font-bold text-slate-900 text-lg mt-3">Tahap 3 — Rukun Jual Beli</h3>
            <p class="text-xs text-slate-600 mt-1">Tiga rukun utama: Al-‘Aqidan, Al-Ma‘qud ‘Alaih dan Al-Sighah (Ijab & Kabul).</p>
          </div>
          <div class="flex items-center justify-between pt-3 mt-3 border-t border-slate-100">
            <span id="status-stage-3" class="text-xs font-bold text-slate-500">🔒 Terkunci</span>
            <button id="btn-stage-3" onclick="enterLevel(3)" class="btn-3d px-4 py-2 bg-slate-300 text-slate-500 font-bold text-xs rounded-xl cursor-not-allowed">
              Kunci 🔒
            </button>
          </div>
        </div>

        <!-- Kad Tahap 4 -->
        <div id="card-stage-4" class="bg-white rounded-2xl p-5 border-2 border-slate-200 shadow-md flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-3xl p-2 bg-yellow-100 rounded-xl">🔍</span>
              <span id="badge-stage-4" class="text-xs font-bold px-3 py-1 rounded-full bg-slate-200 text-slate-600">
                Tahap 4
              </span>
            </div>
            <h3 class="font-title font-bold text-slate-900 text-lg mt-3">Tahap 4 — Syarat Jual Beli</h3>
            <p class="text-xs text-slate-600 mt-1">Syarat Aqidan, syarat barang dan harga, serta 5 syarat sah Ijab dan Kabul.</p>
          </div>
          <div class="flex items-center justify-between pt-3 mt-3 border-t border-slate-100">
            <span id="status-stage-4" class="text-xs font-bold text-slate-500">🔒 Terkunci</span>
            <button id="btn-stage-4" onclick="enterLevel(4)" class="btn-3d px-4 py-2 bg-slate-300 text-slate-500 font-bold text-xs rounded-xl cursor-not-allowed">
              Kunci 🔒
            </button>
          </div>
        </div>

        <!-- Kad Tahap 5 -->
        <div id="card-stage-5" class="bg-white rounded-2xl p-5 border-2 border-slate-200 shadow-md flex flex-col justify-between md:col-span-2">
          <div>
            <div class="flex items-center justify-between">
              <span class="text-3xl p-2 bg-amber-100 rounded-xl">👑</span>
              <span id="badge-stage-5" class="text-xs font-bold px-3 py-1 rounded-full bg-slate-200 text-slate-600">
                Tahap 5 (Akhir)
              </span>
            </div>
            <h3 class="font-title font-bold text-slate-900 text-lg mt-3">Tahap 5 — Hukum Jual Beli & Ulang Kaji</h3>
            <p class="text-xs text-slate-600 mt-1">Lima hukum jual beli (Harus, Wajib, Sunat, Makruh, Haram) serta penilaian menyeluruh topik Pelajaran 1.</p>
          </div>
          <div class="flex items-center justify-between pt-3 mt-3 border-t border-slate-100">
            <span id="status-stage-5" class="text-xs font-bold text-slate-500">🔒 Terbuka Selepas Tahap 4 Selesai</span>
            <button id="btn-stage-5" onclick="enterLevel(5)" class="btn-3d px-5 py-2 bg-slate-300 text-slate-500 font-bold text-xs rounded-xl cursor-not-allowed">
              Kunci 🔒
            </button>
          </div>
        </div>

      </div>

      <!-- Bar Bawah Menu Tahap -->
      <div class="w-full flex flex-col sm:flex-row items-center justify-between bg-emerald-900 text-white rounded-2xl p-3.5 px-4 gap-3">
        <div class="flex items-center space-x-2 text-xs">
          <span class="text-lg">💡</span>
          <span>Dapatkan <strong>10/10</strong> pada setiap tahap untuk membuka tahap seterusnya dan meraih lencana!</span>
        </div>
        <div class="flex items-center space-x-2">
          <button onclick="showScreen('screen-home')" class="px-3.5 py-1.5 bg-emerald-800 hover:bg-emerald-700 text-white rounded-xl font-bold text-xs transition">
            Kembali ke Menu
          </button>
          <button onclick="openBonusMode()" class="px-3.5 py-1.5 bg-amber-500 hover:bg-amber-400 text-slate-900 rounded-xl font-bold text-xs transition flex items-center space-x-1">
            <span>⚡</span>
            <span>Cabaran Kilat</span>
          </button>
        </div>
      </div>
    </section>

    <!-- 3. SKRIN KUIZ & SOALAN (GAMEPLAY) -->
    <section id="screen-game" class="hidden w-full max-w-3xl flex-col items-center">
      
      <!-- Bar Pengepala Tahap Soalan -->
      <div class="w-full bg-white rounded-2xl border-2 border-emerald-300 p-4 shadow-md mb-3 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <button onclick="confirmExitLevel()" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 rounded-xl text-slate-700 text-xs font-bold transition flex items-center space-x-1">
            <span>✕</span>
            <span>Kembali ke Menu</span>
          </button>
          <div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-emerald-700" id="game-location-tag">Tahap 1</div>
            <h3 class="font-title font-bold text-base md:text-lg text-slate-800" id="game-stage-title">Pengertian Jual Beli</h3>
          </div>
        </div>

        <!-- Kaunter Soalan & Markah Semasa -->
        <div class="flex items-center space-x-3">
          <div class="text-right">
            <div class="text-[10px] text-slate-500 font-semibold uppercase">Soalan</div>
            <div class="font-title font-bold text-emerald-700 text-sm md:text-base">
              <span id="current-q-num">1</span> / 10
            </div>
          </div>
          <div class="w-10 h-10 rounded-full bg-amber-100 border-2 border-amber-400 flex items-center justify-center font-title font-bold text-amber-800 text-xs shadow-inner" id="level-score-counter">
            0/10
          </div>
        </div>
      </div>

      <!-- Bilah Garis Kemajuan Soalan -->
      <div class="w-full bg-slate-200 h-2.5 rounded-full overflow-hidden mb-4 shadow-inner">
        <div id="game-progress-bar" class="bg-gradient-to-r from-emerald-500 to-teal-500 h-full w-10% transition-all duration-300"></div>
      </div>

      <!-- Bar Pilihan Mod Menjawab (Tekan Jawapan Biasa / Mod Isyarat Jari Skrin) -->
      <div class="w-full bg-emerald-50 border border-emerald-200 rounded-2xl p-2.5 mb-3 flex flex-wrap items-center justify-between gap-2 shadow-sm">
        <div class="flex items-center space-x-2">
          <span class="text-xs font-bold text-emerald-900 flex items-center">
            <span class="mr-1">🎮</span> Kaedah Menjawab:
          </span>
          <div class="inline-flex rounded-xl bg-white p-1 border border-emerald-300 shadow-inner">
            <button id="btn-mode-touch" onclick="setAnswerMode('touch')" class="px-3 py-1 rounded-lg text-xs font-bold bg-emerald-600 text-white shadow-sm transition flex items-center space-x-1">
              <span>👆</span>
              <span>Tekan Jawapan</span>
            </button>
            <button id="btn-mode-gesture" onclick="setAnswerMode('gesture')" class="px-3 py-1 rounded-lg text-xs font-bold text-slate-600 hover:text-emerald-700 transition flex items-center space-x-1">
              <span>🖐️</span>
              <span>Isyarat Jari Sebenar</span>
            </button>
          </div>
          <button onclick="openChooseModeModal()" class="px-2 py-1 rounded-lg text-[11px] font-bold text-emerald-800 bg-emerald-100/80 hover:bg-emerald-200 transition border border-emerald-300">
            Tukar Mod 🔄
          </button>
